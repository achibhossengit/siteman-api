Project SiteMan {
  database_type: 'PostgreSQL'
}

// ---------------- Enums ----------------

Enum otp_channel {
  sms
  email
}

Enum payment_method {
  gateway
  manual
}

Enum payment_status {
  pending
  success
  failed
}

Enum custom_category_scope {
  attendance
  extrawork
  sitecost
  hiddencost
  sitecash
  sitecashreturn
  sitebill
}

Enum activity_action {
  addition
  change
  deletion
  merge
}

// ============================================================
// F1 / F2 / F5 — Auth, User, Capability, Site scope
// ============================================================

Table user {
  id                    bigint      [pk]
  company_id            bigint      [ref: > company.id, null, note: 'NULL for system users']
  name                  varchar     [not null]
  phone_number          varchar     [not null, unique, note: 'BD phone, normalized +8801XXXXXXXXX (F1.1)']
  email                 varchar     [null]
  email_verified        boolean     [not null, default: false, note: 'email change confirmed via OTP (F1)']
  
  password              varchar     [not null, note: 'hashed']
  is_active             boolean     [not null, default: true]
  is_superuser          boolean     [not null, default: false, note: 'system-scope only (F1.2)']
  is_staff              boolean     [not null, default: false, note: 'system-scope only (F1.2)']

  created_at            timestamp   [not null]
  created_by            bigint      [ref: > user.id, null]
  updated_at            timestamp   [not null]
  deleted_at            timestamp   [null, note: 'deactivate only; hard-delete blocked while any created_by/actor ref exists (RESTRICT) — purge effectively never (F5.6)']

  Indexes {
    (name, company_id) [unique]
  }
}

Table group {
  id    bigint  [pk]
  name  varchar [not null, unique]
}

Table content_type {
  id            int       [pk]
  app_label     varchar
  model         varchar

  indexes {
    (app_label, model) [unique]
  }
}

Table permission {
  id                int       [pk]
  name              varchar
  content_type_id   int       [ref: > content_type.id]
  codename          varchar

  indexes {
    (content_type_id, codename) [unique]
  }
}

Table user_group {
  id        bigint [pk]
  user_id   bigint [ref: > user.id, not null]
  group_id  bigint [ref: > group.id, not null]

  Indexes {
    (user_id, group_id) [unique]
  }
}

Table user_permissions {
  id             bigint [pk]
  user_id        int [ref: > user.id]
  permission_id  int [ref: > permission.id]

  indexes {
    (user_id, permission_id) [unique]
  }
}

Table group_permissions {
  id             bigint [pk]
  group_id       int [ref: > group.id]
  permission_id  int [ref: > permission.id]

  indexes {
    (group_id, permission_id) [unique]
  }
}

Table session {
  session_key    varchar [pk]
  session_data   text
  expire_date    datetime
}

Table admin_log {
  id                int       [pk]
  action_time       datetime
  user_id           int       [ref: > user.id]
  content_type_id   int       [ref: > content_type.id]
  object_id         text
  object_repr       varchar
  action_flag       smallint
  change_message    text
}

Table user_site {
  id          bigint    [pk]
  user_id     bigint    [ref: > user.id, not null]
  site_id     bigint    [ref: > site.id, not null]
  created_at  timestamp [not null]
  created_by  bigint    [ref: > user.id, not null]
  updated_at  timestamp [not null]

  Indexes {
    (user_id, site_id) [unique]
  }
}

// ============================================================
// F2 — Platform (SystemConfig singleton, reset log)
// ============================================================

Table system_config {
  id                              bigint    [pk, note: 'Singleton (django-solo), F2.10']
  maintenance_mode                boolean   [not null, default: false]
  subscription_renew_notification int       [not null, default: 5,  note: 'days BEFORE paid_until (F4.7)']
  company_deactivate_after_expiry int       [not null, default: 10, note: 'days AFTER expiry to deactivate (F4.6)']
  delete_deactivated_company      int       [not null, default: 60, note: 'days deactivated before purge']
  created_at                      timestamp [not null]
  updated_at                      timestamp [not null]
}

Table company_reset_log {
  id              bigint    [pk]
  company_id      bigint    [ref: > company.id, not null, note: 'plain column — survives the wipe (F2.11)']
  reset_at        timestamp [not null]
  reset_by  bigint    [ref: > user.id, not null, note: 'actor (system scope)']
  otp_verified    boolean   [not null, default: true]
}

// ============================================================
// F3 — Company, company config
// ============================================================

Table company {
  id                  bigint    [pk]
  name                varchar   [not null]
  is_active           boolean   [not null, default: true, note: 'deactivated => logins blocked (F2.3)']
  open_site_limit     int       [not null, default: 1,  note: 'cache; -1 = no limit']
  active_user_limit   int       [not null, default: -1, note: 'cache; -1 = no limit']
  active_labour_limit int       [not null, default: -1, note: 'cache; -1 = no limit']
  paid_until         date      [null, note: 'cache of active subscription paid_until (F4.6)']
  gateway_customer_ref varchar [null, note: 'saved gateway customer/instrument id for auto-renew charges (F4.3)']
  created_at          timestamp [not null]
  updated_at          timestamp [not null]
  deleted_at          timestamp [null, note: 'purge target after deactivation window']
}

Table company_config {
  id                    bigint    [pk]
  company_id            bigint    [ref: - company.id, not null, unique, note: 'one-to-one']
  allow_labour_transfer boolean   [not null, default: true, note: 'false => block labour transfer company-wide (F7.2)']
  auto_renew            boolean   [not null, default: false, note: 'F4.3: on expiry auto-charge + extend using the latest subscription variant; false = let the term lapse (this is "cancel")']
  updated_at            timestamp [not null]
}

// ============================================================
// F2.4 / F4 — Subscription plan, subscription, payment
// ============================================================

Table plan {
  id                  bigint    [pk]
  name                varchar   [not null, note: 'Free / Basic / Popular / Business / Custom']
  open_site_limit     int       [not null, note: '-1 = no limit']
  active_user_limit   int       [not null, default: -1]
  active_labour_limit int       [not null, default: -1]
  created_at          timestamp [not null]
  created_by          bigint    [ref: > user.id, not null]
  updated_at          timestamp [not null]
}

Table plan_variant {
  id             bigint    [pk]
  plan_id        bigint    [ref: > plan.id, not null]
  duration       int       [not null, note: 'any duration — 30, 120, 360']
  price          int       [not null]
  discount_price int       [not null, note: 'final price after discount']
  is_active      boolean   [not null, default: true]
  created_at     timestamp [not null]
  created_by     bigint    [ref: > user.id, not null]
  updated_at     timestamp [not null]

  Indexes {
    (plan_id, duration) [unique]
  }
}

Table subscription {
  id                  bigint              [pk]
  company_id          bigint              [ref: > company.id, not null]
  plan_variant_id     bigint              [ref: > plan_variant.id, null, note: 'NULL allowed for fully custom']
  open_site_limit     int                 [not null, note: 'snapshot at purchase']
  active_user_limit   int                 [not null]
  active_labour_limit int                 [not null]
  duration            int                 [not null, note: 'chosen from plan_variant.duration']
  price               int                 [not null, note: 'locked from plan_variant.price']
  discount_price      int                 [not null, note: 'total paid this term']
  paid_until          date                [null, note: 'base_date = max(previous_paid_until, today) new_paid_until = base_date + duration; Null = not payment yet']
  created_at          timestamp           [not null]
  created_by          bigint              [ref: > user.id, not null]
  updated_at          timestamp           [not null]

  Indexes {
    company_id
  }
}

Table payment {
  id              bigint         [pk]
  subscription_id bigint         [ref: > subscription.id, not null]
  company_id      bigint         [not null, note: 'denormalized for tenant filtering']
  method          payment_method [not null]
  amount          int            [not null]
  status          payment_status [not null, default: 'pending']
  transaction_id  varchar        [null, note: 'gateway txn id; NULL for manual']
  paid_at         timestamp      [null]
  gateway_payload jsonb          [null, note: 'raw IPN/webhook']
  created_at      timestamp      [not null]
  created_by      bigint         [ref: > user.id, not null]
  updated_at      timestamp      [not null]
}

// ============================================================
// F6 — Site, site config, billing category, closure summary
// ============================================================

Table site {
  id          bigint    [pk]
  company_id  bigint    [ref: > company.id, not null]
  name        varchar   [not null]
  is_active   boolean   [not null, default: true, note: 'inactive => no new data (F6.2)']
  closed_at   timestamp [null, note: 'NULL = open; set = closed permanently (F6.3)']
  created_at  timestamp [not null]
  created_by  bigint    [ref: > user.id, not null]
  updated_at  timestamp [not null]

  Indexes {
    company_id
  }
}

Table site_config {
  id      bigint [pk]
  company_id  bigint    [ref: > company.id, not null]
  site_id bigint [ref: - site.id, not null, unique, note: 'one-to-one (F6.12)']

  // these are affected on sitecost, sitecash, sitecashreturn, dailyattendance, extrawork, labouradvancepay, labourfoodingpay, labourreturn.

  daily_record_create_window     int [not null, default: 1]
  daily_record_update_window     int [not null, default: 1]
  daily_record_delete_window     int [not null, default: 1]


  attendance_per_labour_per_day_limit int [not null, default: 1, note: 'gates NEW attendance rows per labour/date (F11.1); existing rows unaffected']
  extra_per_labour_per_day_limit      int [not null, default: 1]
  fooding_per_labour_per_day_limit    int [not null, default: 1]
  advance_per_labour_per_day_limit    int [not null, default: -1]

  attendance_present_choices jsonb [not null, note: 'allowed present set, e.g. [0,0.5,1,1.5,2,3]']
  salary_min                 int   [not null]
  salary_max                 int   [not null]
  fooding_min                int   [not null]
  fooding_max                int   [not null]
  advance_min                int   [not null]
  advance_max                int   [not null]

  updated_at timestamp [not null]
}

Table billing_category {
  id            bigint    [pk]
  company_id    bigint    [ref: > company.id, not null]
  site_id       bigint    [ref: > site.id, not null]
  name          varchar   [not null, note: 'e.g. Basement, Floor-1 (F6.9)']
  display_order int       [not null, default: 0]
  is_active     boolean   [not null, default: true]
  is_done       boolean   [not null, default: false, note: 'mark as done => deactivates (F6.11)']
  created_at    timestamp [not null]
  created_by    bigint    [ref: > user.id, not null]
  updated_at    timestamp [not null]

  Indexes {
    (site_id, name) [unique]
  }
}

Table billing_category_details {
  id                  bigint        [pk]
  billing_id bigint        [not null, unique, note: '1:1 with billing_category; cascades when its billing_category is deleted']
  sqft                decimal(12,2) [not null, note: 'physical area']
  rate_per_sqft       decimal(12,2) [not null, note: 'revenue rate per sqft']
  custom_amount       int           [null, note: 'flat contract amount; overrides sqft x rate_per_sqft when set']
  created_at          timestamp     [not null]
  created_by          bigint        [ref: > user.id, not null]
  updated_at          timestamp     [not null]
}

Table site_closure_summary {
  id                         bigint        [pk]
  site_id                    bigint        [ref: - site.id, not null, unique]
  total_present              decimal(12,2) [not null]
  total_salary               bigint        [not null]
  total_extrawork            bigint        [not null]
  total_cost                 bigint        [not null]
  total_hidden_cost          bigint        [not null]
  total_bills                bigint        [not null]
  total_paid_bills           bigint        [not null]
  profit                     bigint        [not null]
  billing_category_breakdown jsonb         [not null, note: 'per-billing_category contract vs billed snapshot']
  created_at                 timestamp     [not null]
  created_by                 bigint        [ref: > user.id, not null]
  updated_at                 timestamp     [not null]
}

// ============================================================
// F3.4 — Custom category
// ============================================================

Table custom_category {
  id            bigint                [pk]
  company_id    bigint                [ref: > company.id, not null]
  site_id       bigint    [ref: > site.id, not null]
  scope         custom_category_scope [not null, note: 'which ledger it serves (F3.4)']
  name          varchar               [not null]
  note          varchar               [null]
  display_order int                   [not null, default: 0]
  is_active     boolean               [not null, default: true]
  created_at    timestamp             [not null]
  created_by    bigint                [ref: > user.id, not null]
  updated_at    timestamp             [not null]

  Indexes {
    (site_id, scope, name) [unique]
  }
}

// ============================================================
// F7 — Labour account
// ============================================================

Table labour {
  id              bigint        [pk]
  company_id      bigint        [ref: > company.id, not null]
  current_site_id bigint        [ref: > site.id, null, note: 'one site at a time; reassign = move (F7.2)']
  name            varchar       [not null]
  default_salary  int           [not null]
  default_present decimal(12,2) [not null]
  default_fooding int           [not null]
  is_active       boolean       [not null, default: true, note: 'sealed work session auto-deactivates (F7.3)']
  created_at      timestamp     [not null]
  created_by      bigint        [ref: > user.id, not null]
  updated_at      timestamp     [not null]
  deleted_at      timestamp     [null, note: 'delete requires zero balance + no refs (RESTRICT); deactivate otherwise (F7.6)']

  Indexes {
    (company_id, name) [unique]
  }
}

// ============================================================
// F10 — Labour work session
// ============================================================

Table labour_session {
  id           bigint    [pk]
  company_id   bigint        [ref: > company.id, not null]
  labour_id    bigint    [ref: > labour.id, not null]
  start_date   date      [not null, note: 'first record after previous session end']
  end_date     date      [not null, note: 'last sealed record date']

  total_present      decimal(12,2) [not null, note: 'intotal present days carried']
  total_salary       bigint    [not null, note: 'intotal salary carried']
  total_extrawork    bigint    [not null, note: 'intotal extra work days carried']
  total_earnings     bigint    [not null, note: 'intotal earnings carried']
  total_taken        bigint    [not null, note: 'intotal taken carried']
  balance            bigint    [not null, note: 'balance carried forward to next session']
  created_at         timestamp [not null, note: 'index will use created_at::date for session uniqueness']
  created_by         bigint    [ref: > user.id, not null]
  updated_at         timestamp [not null]

  Indexes {
    (labour_id, created_at) [unique]
  }
}

Table labour_site_session {
  id              bigint        [pk]
  work_session_id bigint        [ref: > labour_session.id, not null]
  site_id         bigint        [ref: > site.id, not null]
  present         decimal(12,2) [not null]
  extrawork       bigint        [not null]
  fooding         bigint        [not null]
  advance         bigint        [not null]
  salary          bigint        [not null]
  earnings        bigint        [not null]
  payable         bigint        [not null]
  created_at      timestamp     [not null]
  created_by      bigint        [ref: > user.id, not null]
  updated_at      timestamp     [not null]
}

// ============================================================
// F11 — Daily attendance & extra work
// ============================================================

Table daily_attendance {
  id                  bigint        [pk]
  company_id          bigint        [not null]
  labour_id           bigint        [ref: > labour.id, not null]
  site_id             bigint        [ref: > site.id, not null]
  billing_id          bigint        [null, note: 'optional billing category; site may run without categories (F6.9)']
  custom_category_id  bigint        [null, note: 'optional billing category; site may run without categories ']
  date                date          [not null]
  present             decimal(12,2) [not null, note: 'validated against attendance_present_choices']
  salary              int           [not null, note: 'snapshot; seeded from labour.default_salary']
  site_total_present  decimal(12,2) [not null]
  site_total_salary   bigint        [not null]
  created_at          timestamp     [not null]
  created_by          bigint        [ref: > user.id, null]
  updated_at          timestamp     [not null]
  is_sealed           boolean       [not null, default: false, note: 'true = immutable; set by work-session seal (F10)']
  
  Indexes {
    (labour_id, date) [note: 'non-unique; multiple rows per labour/date allowed, gated by attendance_per_labour_per_day_limit (F11.1)']
  }
}

Table extra_work {
  id                  bigint    [pk]
  company_id          bigint    [not null]
  labour_id           bigint    [ref: > labour.id, not null]
  site_id             bigint    [ref: > site.id, not null]
  billing_id          bigint    [null, note: 'optional billing category (F6.9)']
  custom_category_id  bigint    [null, note: 'optional custom category']
  date                date      [not null]
  amount              int       [not null]
  note                varchar   [null]
  site_total_amount   bigint    [not null]
  created_at          timestamp [not null]
  created_by          bigint    [ref: > user.id, not null]
  updated_at          timestamp [not null]
  is_sealed           boolean   [not null, default: false, note: 'true = immutable; set by work-session seal (F10)']

  Indexes {
    (labour_id, date)
  }
}

// ============================================================
// F8 / F9 — Advance, fooding, return ledgers (categoryless cash)
// ============================================================

Table labour_advance_pay {
  id              bigint    [pk]
  company_id      bigint    [not null]
  labour_id       bigint    [ref: > labour.id, not null]
  site_id         bigint    [ref: > site.id, not null]
  date            date      [not null]
  amount          int       [not null, note: 'validated against advance_min/max']
  note            varchar   [null]
  site_total      bigint    [not null]
  created_at      timestamp [not null]
  created_by      bigint    [ref: > user.id, not null]
  updated_at      timestamp [not null]
  is_sealed       boolean   [not null, default: false, note: 'true = immutable; set by work-session seal (F10)']
}

Table labour_fooding_pay {
  id              bigint    [pk]
  company_id      bigint    [not null]
  labour_id       bigint    [ref: > labour.id, not null]
  site_id         bigint    [ref: > site.id, not null]
  date            date      [not null]
  amount          int       [not null, note: 'seeded from default_fooding; validated against fooding_min/max']
  note            varchar   [null]
  site_total      bigint    [not null]
  created_at      timestamp [not null]
  created_by      bigint    [ref: > user.id, null]
  updated_at      timestamp [not null]
  is_sealed       boolean   [not null, default: false, note: 'true = immutable; set by work-session seal (F10)']
}

Table labour_return {
  id              bigint    [pk]
  company_id      bigint    [not null]
  labour_id       bigint    [ref: > labour.id, not null]
  site_id         bigint    [ref: > site.id, not null]
  date            date      [not null]
  amount          int       [not null]
  note            varchar   [null]
  site_total      bigint    [not null]
  created_at      timestamp [not null]
  created_by      bigint    [ref: > user.id, not null]
  updated_at      timestamp [not null]
  is_sealed       boolean   [not null, default: false, note: 'true = immutable; set by work-session seal (F10)']
}

// ============================================================
// F12 — Site expense (construction cost + hidden cost)
// ============================================================

Table site_cost {
  id                  bigint    [pk]
  company_id          bigint    [not null]
  site_id             bigint    [ref: > site.id, not null]
  billing_id          bigint    [null, note: 'optional billing category (F6.9)']
  custom_category_id  bigint    [null, note: 'optional sitecost category; prompt when scope count > 0 (F3.4)']
  date                date      [not null]
  amount              int       [not null]
  note                varchar   [null]
  site_total          bigint    [not null]
  created_at          timestamp [not null]
  created_by          bigint    [ref: > user.id, not null]
  updated_at          timestamp [not null]
}

Table hidden_cost {
  id                  bigint    [pk]
  company_id          bigint    [not null]
  site_id             bigint    [ref: > site.id, not null]
  billing_id          bigint    [null, note: 'null => site-general (not pro-rated, F15.8); optional (F6.9)']
  custom_category_id  bigint    [null, note: 'optional hiddencost category (F3.4)']
  date                date      [not null]
  amount              int       [not null]
  note                varchar   [null]
  site_total          bigint    [not null]
  created_at          timestamp [not null]
  created_by          bigint    [ref: > user.id, not null]
  updated_at          timestamp [not null]
}

// ============================================================
// F13 — Site cash (deposit + return/withdrawal)
// ============================================================

Table site_cash {
  id                  bigint    [pk]
  company_id          bigint    [not null]
  site_id             bigint    [ref: > site.id, not null]
  custom_category_id  bigint    [null, note: 'optional sitecash category (F3.4)']
  date                date      [not null]
  amount              int       [not null]
  note                varchar   [null]
  site_total          bigint    [not null]
  created_at          timestamp [not null]
  created_by          bigint    [ref: > user.id, not null]
  updated_at          timestamp [not null]
}

Table site_cash_return {
  id                  bigint    [pk]
  company_id          bigint    [not null]
  site_id             bigint    [ref: > site.id, not null]
  custom_category_id  bigint    [null, note: 'optional sitecashreturn category (F3.4)']
  date                date      [not null]
  amount              int       [not null]
  note                varchar   [null]
  site_total          bigint    [not null]
  created_at          timestamp [not null]
  created_by          bigint    [ref: > user.id, not null]
  updated_at          timestamp [not null]
}

// ============================================================
// F14 — Site bill
// ============================================================

Table site_bill {
  id                  bigint    [pk]
  company_id          bigint    [not null]
  site_id             bigint    [ref: > site.id, not null]
  billing_id          bigint    [null, note: 'optional billing category (F6.9)']
  custom_category_id  bigint    [null, note: 'optional sitebill category (F3.4)']
  date                date      [not null]
  amount              int       [not null]
  note                varchar   [null]
  site_total          bigint    [not null]
  created_at          timestamp [not null]
  created_by          bigint    [ref: > user.id, not null]
  updated_at          timestamp [not null]
}

// ============================================================
// F16 — Activity log (permanent, immutable)
// ============================================================

Table activity_log {
  id           bigint          [pk]
  company_id   bigint          [ref: > company.id, not null]
  actor_id     bigint          [ref: > user.id, not null, note: 'who acted — the creator; no created_by/updated_at, logs are immutable (F16)']
  content_type_id  bigint     [ref: > content_type.id]
  object_id    bigint          [not null]
  action_flag       activity_action [not null]
  before       jsonb           [null, note: 'snapshot before update/delete/merge']
  after        jsonb           [null, note: 'snapshot after create/update/merge']
  note         varchar         [null, note: 'required for update/delete of financial records']
  created_at   timestamp       [not null, note: 'event time; never updated or deleted (F16.3)']

  Indexes {
    (company_id, content_type_id, object_id)
    (company_id, action_flag)
  }
}

// ============================================================
// FK delete actions (standalone — inline refs cannot carry delete:)
// Category FKs are SET NULL: deleting a category nulls the FK on its rows;
// to consolidate instead, re-point rows to another category first (F3.4 / F6.15).
// ============================================================

Ref: billing_category_details.billing_id - billing_category.id [delete: cascade]

Ref: daily_attendance.billing_id  > billing_category.id   [delete: set null]
Ref: extra_work.billing_id > billing_category.id   [delete: set null]
Ref: site_cost.billing_id         > billing_category.id   [delete: set null]
Ref: hidden_cost.billing_id       > billing_category.id   [delete: set null]
Ref: site_bill.billing_id         > billing_category.id   [delete: set null]

Ref: daily_attendance.custom_category_id > custom_category.id  [delete: set null]
Ref: extra_work.custom_category_id       > custom_category.id  [delete: set null]
Ref: site_cost.custom_category_id        > custom_category.id  [delete: set null]
Ref: hidden_cost.custom_category_id      > custom_category.id  [delete: set null]
Ref: site_cash.custom_category_id        > custom_category.id  [delete: set null]
Ref: site_cash_return.custom_category_id > custom_category.id  [delete: set null]
Ref: site_bill.custom_category_id        > custom_category.id  [delete: set null]

// ============================================================
// Table groups (visual grouping in dbdiagram.io)
// ============================================================

TableGroup auth {
  user
  group
  user_group
  user_site
}

TableGroup platform {
  system_config
  company_reset_log
}

TableGroup company_and_subscription {
  company
  company_config
  plan
  plan_variant
  subscription
  payment
}

TableGroup sites_and_billing {
  site
  site_config
  billing_category
  billing_category_details
  custom_category
  site_closure_summary
}

TableGroup labour_group {
  labour
  labour_session
  labour_site_session
}

TableGroup ledgers {
  daily_attendance
  extra_work
  labour_advance_pay
  labour_fooding_pay
  labour_return
  site_cost
  hidden_cost
  site_cash
  site_cash_return
  site_bill
}

TableGroup activity {
  activity_log
}


DiagramView Default {
  Tables {
    billing_category
    daily_attendance
    extra_work
    site_cost
    hidden_cost
    site_cash
    site_cash_return
    site_bill
    activity_log
    custom_category
    labour_advance_pay
    labour_fooding_pay
    labour_session
    labour_return
    labour_site_session
  }
  Notes { * }
}
