Project SiteMan {
  database_type: 'PostgreSQL'
}

// ---------------- Enums ----------------

Enum otp_channel {
  sms
  email
}

Enum payment_method {
  gateway
  manual
}

Enum payment_status {
  pending
  success
  failed
}


Enum labour_payment_category {
  advance
  fooding
}

Enum site_cash_category {
  food
  equipment
}

Enum labour_payment_type {
  payment
  return
}

Enum site_cash_type {
  deposit
  withdrawal
  cost
}

Enum activity_action {
  addition
  change
  deletion
  merge
}

// ============================================================
// F1 / S1 / F4 — Auth, User, Capability, Site scope
// ============================================================

Table user {
  id                    bigint      [pk]
  company_id            bigint      [ref: > company.id, null, note: 'NULL for system users']
  name                  varchar     [not null]
  phone_number          varchar     [not null, unique, note: 'BD phone, normalized +8801XXXXXXXXX (F1.1)']
  email                 varchar     [null]
  
  password              varchar     [not null, note: 'hashed']
  is_active             boolean     [not null, default: true]
  is_superuser          boolean     [not null, default: false, note: 'system-scope only (F1.2)']
  is_staff              boolean     [not null, default: false, note: 'system-scope only (F1.2)']

  created_at            timestamp   [not null]
  updated_at            timestamp   [not null]
  deleted_at            timestamp   [null, note: 'deactivate only; hard-delete blocked while any created_by/actor ref exists (RESTRICT) — purge effectively never (F4.6)']

  Indexes {
    (name, company_id) [unique]
  }
}

Table group {
  id    bigint  [pk]
  name  varchar [not null, unique]
}

Table content_type {
  id            int       [pk]
  app_label     varchar
  model         varchar

  indexes {
    (app_label, model) [unique]
  }
}

Table permission {
  id                int       [pk]
  name              varchar
  content_type_id   int       [ref: > content_type.id]
  codename          varchar

  indexes {
    (content_type_id, codename) [unique]
  }
}

Table user_group {
  id        bigint [pk]
  user_id   bigint [ref: > user.id, not null]
  group_id  bigint [ref: > group.id, not null]

  Indexes {
    (user_id, group_id) [unique]
  }
}

Table user_permissions {
  id             bigint [pk]
  user_id        int [ref: > user.id]
  permission_id  int [ref: > permission.id]

  indexes {
    (user_id, permission_id) [unique]
  }
}

Table group_permissions {
  id             bigint [pk]
  group_id       int [ref: > group.id]
  permission_id  int [ref: > permission.id]

  indexes {
    (group_id, permission_id) [unique]
  }
}

Table session {
  session_key    varchar [pk]
  session_data   text
  expire_date    datetime
}

Table admin_log {
  id                int       [pk]
  action_time       datetime
  user_id           int       [ref: > user.id]
  content_type_id   int       [ref: > content_type.id]
  object_id         text
  object_repr       varchar
  action_flag       smallint
  change_message    text
}

Table user_site {
  id          bigint    [pk]
  user_id     bigint    [ref: > user.id, not null]
  site_id     bigint    [ref: > site.id, not null]
  created_at  timestamp [not null]
  created_by  bigint    [ref: > user.id, not null]
  updated_at  timestamp [not null]

  Indexes {
    (user_id, site_id) [unique]
  }
}

// ============================================================
// S1 — Platform (SystemConfig singleton, reset log)
// ============================================================

Table system_config {
  id                              bigint    [pk, note: 'Singleton (django-solo), S1.10']
  maintenance_mode                boolean   [not null, default: false]
  subscription_renew_notification int       [not null, default: 5,  note: 'days BEFORE paid_until (F3.7)']
  company_deactivate_after_expiry int       [not null, default: 10, note: 'days AFTER expiry to deactivate (F3.6)']
  delete_deactivated_company      int       [not null, default: 60, note: 'days deactivated before purge']
  created_at                      timestamp [not null]
  updated_at                      timestamp [not null]
}

Table company_reset_log {
  id              bigint    [pk]
  company_id      bigint    [ref: > company.id, not null, note: 'plain column — survives the wipe (S1.11)']
  reset_at        timestamp [not null]
  reset_by  bigint    [ref: > user.id, not null, note: 'actor (system scope)']
  otp_verified    boolean   [not null, default: true]
}

// ============================================================
// F2 — Company, company config
// ============================================================
Table company {
  id                  bigint    [pk]
  name                varchar   [not null]
  is_active           boolean   [not null, default: true, note: 'deactivated => logins blocked']
  created_at          timestamp [not null]
  updated_at          timestamp [not null]
  deleted_at          timestamp [null, note: 'purge target after deactivation window']
}

Table company_config {
  id                    bigint    [pk]
  company_id            bigint    [ref: - company.id, not null, unique, note: 'one-to-one']
  allow_labour_transfer boolean   [not null, default: true, note: 'false => block labour transfer company-wide (F6.2)']

  updated_at            timestamp [not null]
}

// ============================================================
// S1.4 / F3 — Subscription plan, subscription, payment
// ============================================================

Table plan {
  id                  bigint    [pk]
  name                varchar   [not null, note: 'Free / Basic / Popular / Business / Custom']
  open_site_limit     int       [not null, note: '-1 = no limit']
  active_user_limit   int       [not null, default: -1]
  active_labour_limit int       [not null, default: -1]
  created_at          timestamp [not null]
  created_by          bigint    [ref: > user.id, not null]
  updated_at          timestamp [not null]
}


Table plan_variant {
  id             bigint    [pk]
  plan_id        bigint    [ref: > plan.id, not null]
  duration       int       [not null, note: 'any duration — 30, 120, 360']
  price          int       [not null]
  discount_price int       [not null, note: 'final price after discount']
  is_active      boolean   [not null, default: true]
  created_at     timestamp [not null]
  created_by     bigint    [ref: > user.id, not null]
  updated_at     timestamp [not null]

  Indexes {
    (plan_id, duration) [unique]
  }
}


Table custom_plan {
  id                  bigint    [pk]
  company_id          bigint              [ref: > company.id, not null, note: 'Because, it is created for specific company']
  open_site_limit     int       [not null, note: '-1 = no limit']
  active_user_limit   int       [not null, default: -1]
  active_labour_limit int       [not null, default: -1]
  duration            int       [not null, note: 'term length in days; payment copies it like the variant path']
  price               int       [note: 'negotiated fixed price for the full term']
  is_active           boolean   [not null, default: true, note: 'retire an old deal without deleting it']
  created_at          timestamp [not null]
  created_by          bigint    [ref: > user.id, not null]
  updated_at          timestamp [not null]
}


Table subscription {
  id                  bigint              [pk]
  company_id          bigint              [ref: - company.id, not null, note: 'one row per company — current entitlement cache, updated in place; history lives in payment']
  // at most one of variant_id / custom_plan_id (DB check: not both); neither = a hand-set / trial term
  variant_id     bigint              [ref: > plan_variant.id, null]
  custom_plan_id      bigint              [ref: > custom_plan.id, null, note: 'the negotiated deal this company is on; suggests the next renewal billing']
  open_site_limit     int                 [not null, note: 'snapshot at purchase']
  active_user_limit   int                 [not null]
  active_labour_limit int                 [not null]

  paid_until          date                [null, note: 'set from the succeeding payment period_end; Null = never activated. Free is an ordinary plan tier — its 0-price, long-duration variant yields a real far-future paid_until (no sentinel)']
  created_at          timestamp           [not null]
  updated_at          timestamp           [not null]

  Indexes {
    (company_id) [unique, note: 'one subscription row per company']
  }
}

Table payment {
  id              bigint          [pk]
  company_id      bigint          [ref: > company.id, null, note: 'denormalized for tenant filtering; SET NULL on company delete — financial record survives']
  status          payment_status  [not null, default: 'pending']
  method          payment_method  [not null]
  variant_id      bigint          [null, note: 'SET NULL on variant delete']
  custom_plan_id  bigint          [null, note: 'SET NULL on custom plan delete']
  amount            int           [not null, note: 'locked from plan_variant.discount_price (variant) or custom_plan.price (custom deal); its may different if upgrade or downgrade apply']

  period_start    date            [null, note: 'coverage this payment buys; set when payment succeeds; max(active subscription enddate, today)']
  period_end      date            [null, note: 'period_start + the variant/custom_plan duration']
  paid_at         timestamp       [null]

  transaction_id  varchar         [null, unique, note: 'gateway txn id; NULL for manual; dedupe webhook']
  gateway_payload jsonb           [null, note: 'raw IPN/webhook']
  created_at      timestamp       [not null]
  created_by      bigint          [ref: > user.id, null]
  updated_at      timestamp       [not null]
}

// ============================================================
// F5 — Site, billing category, closure summary
// ============================================================

Table site {
  id          bigint    [pk]
  company_id  bigint    [ref: > company.id, not null]
  name        varchar   [not null]
  is_active   boolean   [not null, default: true, note: 'inactive => no new data (F5.2)']
  closed_at   timestamp [null, note: 'NULL = open; set = closed permanently (F5.3)']
  created_at  timestamp [not null]
  created_by  bigint    [ref: > user.id, not null]
  updated_at  timestamp [not null]

  Indexes {
    (company_id, name) [unique]
  }
}

Table billing_category {
  id            bigint    [pk]
  company_id    bigint    [ref: > company.id, not null]
  site_id       bigint    [ref: > site.id, not null]
  name          varchar   [not null, note: 'e.g. Basement, Floor-1 (F5.9)']
  is_active     boolean   [not null, default: true]
  is_done       boolean   [not null, default: false, note: 'mark as done => deactivates (F5.11)']
  created_at    timestamp [not null]
  created_by    bigint    [ref: > user.id, not null]
  updated_at    timestamp [not null]
}

Table billing_category_details {
  id                  bigint        [pk]
  billing_id bigint        [not null, unique, note: '1:1 with billing_category; cascades when its billing_category is deleted']
  sqft                decimal(12,2) [not null, note: 'physical area']
  rate_per_sqft       decimal(12,2) [not null, note: 'revenue rate per sqft']
  custom_amount       int           [null, note: 'flat contract amount; overrides sqft x rate_per_sqft when set']
  created_at          timestamp     [not null]
  created_by          bigint        [ref: > user.id, not null]
  updated_at          timestamp     [not null]
}

Table site_closure_summary {
  id                         bigint        [pk]
  site_id                    bigint        [ref: - site.id, not null, unique]
  total_present              decimal(12,2) [not null]
  total_salary               bigint        [not null]
  total_extrawork            bigint        [not null]
  total_site_cost            bigint        [not null, note: 'SUM(site_cash.amount) where type = cost']
  total_hidden_cost          bigint        [not null]
  total_bills                bigint        [not null]
  total_paid_bills           bigint        [not null]
  profit                     bigint        [not null]
  billing_category_breakdown jsonb         [not null, note: 'per-billing_category contract vs billed snapshot']
  created_at                 timestamp     [not null]
  created_by                 bigint        [ref: > user.id, not null]
  updated_at                 timestamp     [not null]
}

// ============================================================
// F6 — Labour account
// ============================================================

Table labour {
  id              bigint        [pk]
  company_id      bigint        [ref: > company.id, not null]
  current_site_id bigint        [ref: > site.id, not null, note: 'one site at a time; reassign = move (F6.2)']
  name            varchar       [not null]
  default_salary  int           [not null]
  default_present decimal(12,2) [not null]
  default_fooding int           [not null]
  is_active       boolean       [not null, default: true, note: 'sealed work session auto-deactivates (F6.3)']
  created_at      timestamp     [not null]
  created_by      bigint        [ref: > user.id, not null]
  updated_at      timestamp     [not null]
}

Table labour_detail {
  id           bigint    [pk]
  company_id   bigint    [ref: > company.id, not null]
  labour_id    bigint    [ref: - labour.id, not null, unique, note: 'one-to-one']
  phone        varchar   [null]
  father_name  varchar   [null]
  mother_name  varchar   [null]
  address      varchar   [null]
  nid          varchar   [null]
  gender       varchar   [null]
  updated_at   timestamp [not null]
}

// ============================================================
// F8 — Labour work session
// ============================================================

Table labour_session {
  id           bigint    [pk]
  company_id   bigint        [ref: > company.id, not null]
  labour_id    bigint    [ref: > labour.id, not null]
  start_date   date      [not null, note: 'first record after previous session end']
  end_date     date      [not null, note: 'last sealed record date']

  total_present      decimal(12,2) [not null, note: 'intotal present days carried']
  total_salary       bigint    [not null, note: 'intotal salary carried']
  total_extra        bigint    [not null, note: 'intotal extra work days carried']
  total_earnings     bigint    [not null, note: 'intotal earnings carried']
  total_taken        bigint    [not null, note: 'intotal taken carried']
  balance            bigint    [not null, note: 'balance carried forward to next session']
  created_at         timestamp [not null, note: 'index will use created_at::date for session uniqueness']
  created_by         bigint    [ref: > user.id, not null]
  updated_at         timestamp [not null]
}

Table labour_site_session {
  id              bigint        [pk]
  work_session_id bigint        [ref: > labour_session.id, not null]
  site_id         bigint        [ref: > site.id, not null]
  present         decimal(12,2) [not null]
  extrawork       bigint        [not null]
  fooding         bigint        [not null]
  advance         bigint        [not null]
  salary          bigint        [not null]
  earnings        bigint        [not null]
  payable         bigint        [not null]
  created_at      timestamp     [not null]
  created_by      bigint        [ref: > user.id, not null]
  updated_at      timestamp     [not null]
}

// ============================================================
// F9 — Attendance (daily attendance + extra work)
// Totals / running balances: aggregate on read (SUM), not stored.
// ============================================================

Table attendance {
  id                  bigint          [pk]
  company_id          bigint          [not null]
  labour_id           bigint          [ref: > labour.id, not null]
  site_id             bigint          [ref: > site.id, not null]
  billing_id          bigint          [null, note: 'optional billing category; site may run without categories (F5.9)']
  date                date            [not null]
  present             decimal(12,2)   [null, note: 'validated against attendance_present_choices']
  salary              int             [null, note: 'snapshot from labour.default_salary']
  extra               int             [null, note: 'validated against company config extrawork_limit']
  note                varchar   [null]
  created_at          timestamp [not null]
  created_by          bigint    [ref: > user.id, null]
  updated_at          timestamp [not null]
  is_sealed           boolean   [not null, default: false, note: 'true = immutable; set by work-session seal (F8)']
}

// ============================================================
// F7 — Labour pay / return (advance | fooding | return)
// ============================================================

Table labour_payment {
  id              bigint                  [pk]
  company_id      bigint                  [not null]
  labour_id       bigint                  [ref: > labour.id, not null]
  site_id         bigint                  [ref: > site.id, not null]
  date            date                    [not null]
  type            labour_payment_type     [not null, note: 'payment | return']
  category        labour_payment_category [null, note: 'advance | fooding']
  amount          int                     [not null, note: 'amount paid or returned']
  note            varchar                 [null]
  created_at      timestamp               [not null]
  created_by      bigint                  [ref: > user.id, not null]
  updated_at      timestamp               [not null]
  is_sealed       boolean                 [not null, default: false, note: 'true = immutable; set by work-session seal (F8)']
}

// ============================================================
// F10 — Site cash ledger (deposit, withdrawal, cost)
// Former site_cost + site_cash merged — same permissions and lifecycle.
// ============================================================

Table site_cash {
  id                  bigint             [pk]
  company_id          bigint             [not null]
  site_id             bigint             [ref: > site.id, not null]
  billing_id          bigint             [null, note: 'optional billing category (F5.9); nullable for all types']
  type                site_cash_type     [not null]
  category            site_cash_category [null, note: 'food | equipment; meaningful when type = cost; nullable — client may hide or ignore for deposit/withdrawal']
  date                date               [not null]
  amount              int                [not null]
  note                varchar            [null]
  created_at          timestamp          [not null]
  created_by          bigint             [ref: > user.id, not null]
  updated_at          timestamp          [not null]
}

Table hidden_cost {
  id                  bigint    [pk]
  company_id          bigint    [not null]
  site_id             bigint    [ref: > site.id, not null]
  billing_id          bigint    [null, note: 'null => site-general (not pro-rated, F13.8); optional (F5.9)']
  date                date      [not null]
  amount              int       [not null]
  note                varchar   [null]
  created_at          timestamp [not null]
  created_by          bigint    [ref: > user.id, not null]
  updated_at          timestamp [not null]
}

// ============================================================
// F12 — Site bill
// ============================================================

Table site_bill {
  id                  bigint    [pk]
  company_id          bigint    [not null]
  site_id             bigint    [ref: > site.id, not null]
  billing_id          bigint    [null, note: 'optional billing category (F5.9)']
  date                date      [not null]
  amount              int       [not null]
  note                varchar   [null]
  created_at          timestamp [not null]
  created_by          bigint    [ref: > user.id, not null]
  updated_at          timestamp [not null]
}

// ============================================================
// F14 — Activity log (permanent, immutable)
// ============================================================

Table activity_log {
  id           bigint          [pk]
  company_id   bigint          [ref: > company.id, not null]
  actor_id     bigint          [ref: > user.id, not null, note: 'who acted — the creator; no created_by/updated_at, logs are immutable (F14)']
  content_type_id  bigint     [ref: > content_type.id]
  object_id    bigint          [not null]
  action_flag       activity_action [not null]
  before       jsonb           [null, note: 'snapshot before update/delete/merge']
  after        jsonb           [null, note: 'snapshot after create/update/merge']
  note         varchar         [null, note: 'required for update/delete of financial records']
  created_at   timestamp       [not null, note: 'event time; never updated or deleted (F14.3)']
}

// ============================================================
// FK delete actions (standalone — inline refs cannot carry delete:)
// Category FKs are SET NULL: deleting a billing category nulls the FK on its rows;
// to consolidate instead, re-point rows to another category first (F5.15).
// ============================================================

Ref: billing_category_details.billing_id - billing_category.id [delete: cascade]

Ref: attendance.billing_id  > billing_category.id   [delete: set null]
Ref: site_cash.billing_id   > billing_category.id   [delete: set null]
Ref: hidden_cost.billing_id > billing_category.id   [delete: set null]
Ref: site_bill.billing_id   > billing_category.id   [delete: set null]

Ref: payment.variant_id     > plan_variant.id [delete: set null]
Ref: payment.custom_plan_id > custom_plan.id  [delete: set null]

// ============================================================
// Table groups (visual grouping in dbdiagram.io)
// ============================================================

TableGroup auth {
  user
  group
  user_group
  user_site
}

TableGroup platform {
  system_config
  company_reset_log
}

TableGroup company_and_subscription {
  company
  company_config
  plan
  plan_variant
  custom_plan
  subscription
  payment
}

TableGroup sites_and_billing {
  site
  billing_category
  billing_category_details
  site_closure_summary
}

TableGroup labour_group {
  labour
  labour_detail
  labour_session
  labour_site_session
}

TableGroup ledgers {
  attendance
  labour_payment
  hidden_cost
  site_cash
  site_bill
}

TableGroup activity {
  activity_log
}


DiagramView Default {
  Tables {
    billing_category
    attendance
    labour_payment
    hidden_cost
    site_cash
    site_bill
    activity_log
    labour_session
    labour_site_session
  }
  Notes { * }
}
