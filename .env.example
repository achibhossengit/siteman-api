# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — POSTGRES_* provision the docker container AND are reused by Django to connect.
# DB_HOST/DB_PORT: Django runs on host, so it reaches the container via localhost:5432.
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# pgAdmin (docker-compose) login at http://localhost:5050
PGADMIN_DEFAULT_EMAIL=admin@siteman.com
PGADMIN_DEFAULT_PASSWORD=admin

# Redis — cache + OTP/ticket store (Django on host reaches container via localhost:6379)
REDIS_URL=redis://localhost:6379/0

# Token expiration time
ACCESS_TOKEN_LIFE_MINUTES=10
REFRESH_TOKEN_LIFE_DAYS=7