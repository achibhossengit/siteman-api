# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Django admin path. Use a random slug in production, e.g. ADMIN_URL=n7k2-backoffice
ADMIN_URL=backoffice
# Comma-separated origins (scheme + host, no path). Frontend origins go here.
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=True
# Cross-origin cookie auth (Netlify → API): set SameSite=None and Secure=True
REFRESH_TOKEN_COOKIE_SAMESITE=Lax
REFRESH_TOKEN_COOKIE_SECURE=False

# Database — Django runs on the host, so it reaches the docker container via localhost:5432.
# Credentials must match the db service in docker-compose.yml.
# Managed hosts usually need a query param, e.g. ...?sslmode=require
DATABASE_URL=postgres://postgres:password@localhost:5432/siteman

# pgAdmin (docker-compose) login at http://localhost:5050
PGADMIN_DEFAULT_EMAIL=admin@siteman.com
PGADMIN_DEFAULT_PASSWORD=admin

# Redis — cache + OTP/ticket store (Django on host reaches container via localhost:6379)
REDIS_URL=redis://localhost:6379/0

# Email delivery — use an address on your verified Resend domain
RESEND_API_KEY=re_xxxxxxxxx
DEFAULT_FROM_EMAIL="SiteMan <otp@example.com>"

# Token expiration time
ACCESS_TOKEN_LIFE_MINUTES=10
REFRESH_TOKEN_LIFE_DAYS=7
# Public self-serve registration (off for MVP)
REGISTRATION_ENABLED=False

# Cloudflare R2 (required when DEBUG=False). Public GET on the bucket/custom domain.
# Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Custom domain: r2.dev subdomain or your CDN host, without https://
# Leave USE_R2_STORAGE unset: on when DEBUG=False. Set True to test R2 locally.
# USE_R2_STORAGE=True
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT_URL=
# R2_CUSTOM_DOMAIN=

# Orphan photo purge cron: python manage.py purge_orphan_photos
# Only deletes users/, labours/, and sitecash/ keys not in DB and older than this many hours.
# PHOTO_ORPHAN_MIN_AGE_HOURS=168

