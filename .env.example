# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Django runs on host; Postgres in docker-compose exposes 5432)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://postgres:password@localhost:5432/postgres

# Used by docker-compose to provision the Postgres container
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# pgAdmin (docker-compose) login at http://localhost:5050
PGADMIN_DEFAULT_EMAIL=admin@siteman.com
PGADMIN_DEFAULT_PASSWORD=admin
